# Copy to /etc/greenhouseapp.env on the Pi (root-owned, mode 640).
# Use your Mac (or API host) LAN IP — not 127.0.0.1 from the Pi's perspective.
API_URL=http://192.168.1.10:3000
# Must match API_TOKEN on the API host (Bearer for /readings and /actions).
API_TOKEN=dev-pi-token-change-me
READ_MS=60000
POLL_MS=30000
# Optional: cap stub sleep for demos (omit on real valves to run full duration)
STUB_WATER_CAP_S=5
